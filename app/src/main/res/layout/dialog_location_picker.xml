<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/location_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="fixed">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Map" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Address" />
    </com.google.android.material.tabs.TabLayout>

    <FrameLayout
        android:id="@+id/tab_container"
        android:layout_width="match_parent"
        android:layout_height="350dp"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/view_precise"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <org.osmdroid.views.MapView
                android:id="@+id/map_picker"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/view_approximate"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/picker_layout_location_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Name"

                app:boxBackgroundMode="outline"
                app:boxStrokeColor="?attr/colorPrimary"
                app:boxStrokeWidth="2dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"

                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/picker_location_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:inputType="text"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/picker_layout_location_city"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="City"

                app:boxBackgroundMode="outline"
                app:boxStrokeColor="?attr/colorPrimary"
                app:boxStrokeWidth="2dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"

                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/picker_location_city"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:inputType="text"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/picker_layout_location_region"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Region"

                app:boxBackgroundMode="outline"
                app:boxStrokeColor="?attr/colorPrimary"
                app:boxStrokeWidth="2dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"

                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/picker_location_region"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:inputType="text"/>
            </com.google.android.material.textfield.TextInputLayout>


            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/picker_layout_location_country"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Country"

                app:boxBackgroundMode="outline"
                app:boxStrokeColor="?attr/colorPrimary"
                app:boxStrokeWidth="2dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"

                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/picker_location_country"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:inputType="text"/>
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>
    </FrameLayout>

    <Button
        android:id="@+id/btn_confirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Confirm"
        android:layout_margin="16dp" />
</LinearLayout>